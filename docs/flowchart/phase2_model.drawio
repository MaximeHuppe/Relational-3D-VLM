                    <mxGeometry x="924" y="920" width="396" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="pd4" value="H_i  [B, 256, 8, 8, 8]" style="rounded=0;whiteSpace=wrap;html=1;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.2;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="992" width="200" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="pde1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=1.3;endArrow=block;endFill=1;" edge="1" parent="1" source="pd1" target="pd2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pde2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=1.3;endArrow=block;endFill=1;" edge="1" parent="1" source="pd2" target="pd3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pde3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#6c8ebf;strokeWidth=1.3;endArrow=block;endFill=1;" edge="1" parent="1" source="pd3" target="pd4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pdn" value="Default share_branch_weights=true: the only thing distinguishing branch 2 from 1 is its tokens. Alternative branch_fusion: gated_mlp." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="924" y="1040" width="400" height="100" as="geometry"/>
                </mxCell>

                <mxCell id="pe" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="1360" y="760" width="400" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="pet" value="&lt;b&gt;(e)&lt;/b&gt;  Intersection + Decoder FiLM" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1374" y="768" width="370" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="peb" value="The product is the only term high only where all three relations hold. Sigmoid first, so it is a soft AND with a usable gradient." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="1374" y="792" width="370" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="pe1" value="cat [H1, H2, H3, Π σ(Hi)]" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.3;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="1374" y="840" width="180" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="pe2" value="1×1–IN–LReLU ×2 → C4&lt;br/&gt;then 3³ refine" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.3;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="1570" y="832" width="170" height="52" as="geometry"/>
                </mxCell>
                <mxCell id="pe3" value="FiLM  y = (1+γ(c)) ⊙ x + β(c)&lt;br/&gt;γ, β from Linear(768 → 2C), zero-init = identity" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.3;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="1374" y="904" width="366" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="pe4" value="Head: Conv3d 32→1, k=1. Weight zeros, bias = log(p/(1−p)), p=0.0016. Untrained model is a constant volume — correspondence tests randomise this conv first." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="1374" y="960" width="370" height="72" as="geometry"/>
                </mxCell>
                <mxCell id="pen" value="FiLM only at 16³ and 32³ (condition_at). Attention at 32³ would be 32,768 queries — 64× the bottleneck budget. Decode 3 is unconditioned so it carries no dead FiLM parameters." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="1374" y="1036" width="370" height="108" as="geometry"/>
                </mxCell>
                <mxCell id="pee1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=1.3;endArrow=block;endFill=1;" edge="1" parent="1" source="pe1" target="pe2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>

                <mxCell id="cap" value="&lt;b&gt;Figure 2.&lt;/b&gt; Stage B encodes only the three ordered anchor channels, injecting continuous world (x, y, z) at every scale. Each clause is grounded independently: a fused clause token plus the relation and structure tokens attend over the 512 bottleneck locations to produce an evidence map H_i. IntersectionFusion combines [H1, H2, H3, H1·H2·H3] and adds the result to the bottleneck. The decoder upsamples with skip concat, FiLM-conditions at 16³ and 32³ from the concatenated clause tokens, and returns one target logit volume. Dashed orange: skips. Dashed purple: token paths. Dashed blue: FiLM context. Same ResidualBlock / EncoderStage / UpBlock primitives as Stage A (LeakyReLU instead of ReLU)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1176" width="2120" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="cap2" value="&lt;b&gt;Forward contract.&lt;/b&gt;  model(anchor_masks, direction_ids, anchor_shape_ids) — and nothing else. STAGE_B_FORBIDDEN_FIELDS have nowhere to go. Variants (--variant): full | anchor_masks_only | prompt_only | prompt_plus_union_mask. Training, loss, metrics, dataset: see the Training-Data-Eval tab." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1252" width="2120" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="cap3" value="Notation: IN = InstanceNorm3d (affine=False). xyz = normalised world coordinates recomputed per scale. E = token width 256. LReLU = LeakyReLU(0.01). Source: src/models/relational_vlm.py and the six modules it composes." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1298" width="2120" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram name="Figure-2-Training-Data-Eval" id="stage-b-train-fig">
        <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="th1" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;Stage B — Training, dataset, loss, metrics&lt;/b&gt;&lt;/font&gt;  &amp;nbsp; Phases 2–4  ·  scripts/train_relational_model.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=20;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="14" width="2000" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="th2" value="The model is identical for oracle and predicted anchors. AnchorProvider is the only place the source is chosen; geometry is always measured from the three channels the model actually sees." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontColor=#111111;" vertex="1" parent="1">
                    <mxGeometry x="40" y="46" width="2000" height="22" as="geometry"/>
                </mxCell>

                <mxCell id="ph0" value="Phase 0  data verification" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="80" width="200" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="ph1" value="Phase 1  Stage A&lt;br/&gt;(all 10 shapes)" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.4;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="280" y="80" width="180" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="ph2" value="Phase 2  overfit&lt;br/&gt;1 scene, Dice ≥ 0.95" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="500" y="80" width="220" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="ph3" value="Phase 3  oracle training  ★ primary" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.6;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="760" y="80" width="280" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="ph4" value="Phase 4  predicted-anchor eval&lt;br/&gt;no retraining" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1080" y="80" width="240" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="phe1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ph0" target="ph1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="phe2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ph1" target="ph2">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="phe3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ph2" target="ph3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="phe4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="ph3" target="ph4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="phe5" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=8 6;strokeColor=#d79b00;strokeWidth=1.4;endArrow=block;endFill=1;" edge="1" parent="1" source="ph1" target="ph4">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="370" y="150"/>
                            <mxPoint x="1200" y="150"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="phn" value="dashed: Stage A checkpoint supplies predicted anchors" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="1340" y="88" width="360" height="36" as="geometry"/>
                </mxCell>

                <mxCell id="da" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="30" y="176" width="530" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="dat" value="&lt;b&gt;(a)&lt;/b&gt;  Dataset and 7 / 2 / 1 split" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="44" y="184" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="dab" value="500 scenes, 64³, RAS, spacing (1,1,1). Exactly ten non-overlapping axis-aligned primitives per scene, binary intensity. Each scene yields 10 candidate (scene, target) examples; the target-class filter keeps:" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="44" y="212" width="500" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="da1" value="&lt;b&gt;train&lt;/b&gt;  400 scenes × 7&lt;br/&gt;cube sphere cylinder&lt;br/&gt;cone pyramid torus capsule&lt;br/&gt;~2,800 examples" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.3;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="44" y="276" width="160" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="da2" value="&lt;b&gt;val&lt;/b&gt;  50 scenes × 2&lt;br/&gt;cuboid, ellipsoid&lt;br/&gt;(never supervised)&lt;br/&gt;~100 examples" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.3;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="220" y="276" width="150" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="da3" value="&lt;b&gt;test&lt;/b&gt;  50 scenes × 1&lt;br/&gt;triangular_prism&lt;br/&gt;(never supervised)&lt;br/&gt;~50 examples" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=1.3;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="386" y="276" width="150" height="88" as="geometry"/>
                </mxCell>
                <mxCell id="dan" value="All ten names remain available as &lt;b&gt;anchors&lt;/b&gt; in every split. Held-out classes have a geometric parent in training (cuboid←cube, ellipsoid←sphere, triangular_prism←cube/pyramid) so transfer is compositional.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Prompt&lt;/b&gt;  “segment the shape that is {d1} to the {a1}, {d2} to the {a2}, and {d3} to the {a3}.” Three distinct directions; anchors ordered by ascending centroid distance. Channel i = clause i.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;One item&lt;/b&gt;  anchor_masks [3,64³], direction_ids [3], anchor_shape_ids [3], target_mask [1,64³] (loss only). Augmentations disabled." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="44" y="376" width="500" height="300" as="geometry"/>
                </mxCell>

                <mxCell id="db" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="580" y="176" width="530" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="dbt" value="&lt;b&gt;(b)&lt;/b&gt;  Training schedules" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="594" y="184" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="db1" value="&lt;b&gt;Phase 2  overfit&lt;/b&gt;  --phase overfit&lt;br/&gt;1 scene, every allowed target (7). Up to 2000 steps, AdamW lr=1e−3, wd=0, constant schedule. Pass if train Dice ≥ 0.95 on a clean eval, else exit non-zero. Bug catcher for channel/clause order, coordinates, decoder — not a result. Oracle anchors by default." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.3;fontSize=11;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="594" y="216" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="db2" value="&lt;b&gt;Phase 3  oracle&lt;/b&gt;  --phase oracle  ★ primary measurement&lt;br/&gt;100 epochs, AdamW lr=3e−4, wd=1e−5, cosine warmup 5. Batch from hardware profile. Checkpoint on val_dice — a transfer metric on cuboid and ellipsoid, never supervised. Full corpus: 2,800 train / 100 val." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.3;fontSize=11;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="594" y="340" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="db3" value="&lt;b&gt;Phase 4  predicted&lt;/b&gt;  --eval-only --anchor-source predicted&lt;br/&gt;Reuse Phase 3 weights. Stage A segments the scene and returns the three named anchors in clause order. Also logs anchor_dice / anchor_iou / empty_anchor_fraction so the target drop is attributed. No retraining." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.3;fontSize=11;spacing=6;" vertex="1" parent="1">
                    <mxGeometry x="594" y="464" width="500" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="dbn" value="Hardware: laptop_mps B=4×accum 4 bf16; rtx5090 B=8 bf16. Autocast off on CPU (33× regression). Smoke profile 0.88 M. seed 20260915." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="594" y="584" width="500" height="96" as="geometry"/>
                </mxCell>

                <mxCell id="dc" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="176" width="530" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="dct" value="&lt;b&gt;(c)&lt;/b&gt;  Loss  (single scale)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="184" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="dc1" value="L = λ_dice · DiceLoss(logits, target_mask)&lt;br/&gt;  + λ_bce · BCEWithLogits(logits, target_mask)&lt;br/&gt;λ_dice = λ_bce = 1  ·  full 64³ only  ·  no DS  ·  no class head" style="rounded=1;whiteSpace=wrap;html=1;align=center;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="220" width="500" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="dcn" value="Soft Dice on sigmoid probabilities, smooth=1. Losses computed in float32 even under autocast (the Dice sum over 262,144 voxels is where half precision loses range). Prior-init head so training locates the target instead of suppressing background." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="312" width="500" height="96" as="geometry"/>
                </mxCell>

                <mxCell id="dd" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="446" width="530" height="250" as="geometry"/>
                </mxCell>
                <mxCell id="ddt" value="&lt;b&gt;(d)&lt;/b&gt;  Metrics" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="454" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="ddn" value="On thresholded masks, τ=0.5. Aggregate &lt;b&gt;and&lt;/b&gt; stratified by target shape, anchor shape, direction, clause slot, and oracle vs predicted.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Dice&lt;/b&gt; and &lt;b&gt;IoU&lt;/b&gt;  — both empty → 1.0; one empty → 0.0.&lt;br/&gt;&lt;b&gt;Hausdorff&lt;/b&gt;  symmetric, on surfaces, world units. Both empty → 0; one empty → NaN (counted, not averaged). Optional 95th-percentile variant.&lt;br/&gt;&lt;br/&gt;Headline result: val/test held-out target classes. Aggregate Dice is not spatial grounding if shuffled prompts and shuffled channels produce the same prediction." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="482" width="500" height="196" as="geometry"/>
                </mxCell>

                <mxCell id="de" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="30" y="716" width="530" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="det" value="&lt;b&gt;(e)&lt;/b&gt;  Input contract and anchor sources" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="44" y="724" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="den" value="&lt;font face='monospace'&gt;forward(anchor_masks, direction_ids, anchor_shape_ids)&lt;/font&gt;&lt;br/&gt;Forbidden: scene_volume, instance_labels, target_mask, target_shape_name, target_instance_id, target_centroid_world.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;oracle&lt;/b&gt;  ground-truth channels from instance_labels, the three names the prompt lists, in clause order. Phases 2–3.&lt;br/&gt;&lt;b&gt;predicted&lt;/b&gt;  Stage A.predict_anchor_masks(scene, names). Scene stops at Stage A. Phase 4.&lt;br/&gt;&lt;br/&gt;anchor_shape_ids is both Stage B’s shape index and Stage A’s prompt_ids, so predicted channels arrive already aligned." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="44" y="756" width="500" height="320" as="geometry"/>
                </mxCell>

                <mxCell id="df" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="580" y="716" width="530" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="dft" value="&lt;b&gt;(f)&lt;/b&gt;  Baselines  (--variant)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="594" y="724" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="df1" value="&lt;b&gt;full&lt;/b&gt;  three ordered channels + full prompt  ★ main" style="rounded=1;whiteSpace=wrap;html=1;align=left;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.3;fontSize=11;spacing=4;" vertex="1" parent="1">
                    <mxGeometry x="594" y="760" width="500" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="df2" value="&lt;b&gt;anchor_masks_only&lt;/b&gt;  three channels, slot embeddings only (no dir/shape/pair)" style="rounded=1;whiteSpace=wrap;html=1;align=left;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.3;fontSize=11;spacing=4;" vertex="1" parent="1">
                    <mxGeometry x="594" y="808" width="500" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="df3" value="&lt;b&gt;prompt_only&lt;/b&gt;  channels zeroed; world xyz survives; full prompt" style="rounded=1;whiteSpace=wrap;html=1;align=left;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.3;fontSize=11;spacing=4;" vertex="1" parent="1">
                    <mxGeometry x="594" y="856" width="500" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="df4" value="&lt;b&gt;prompt_plus_union_mask&lt;/b&gt;  one union channel (ablation only, never the main representation)" style="rounded=1;whiteSpace=wrap;html=1;align=left;arcSize=8;fillColor=#f5f5f5;strokeColor=#999999;strokeWidth=1.3;fontSize=11;spacing=4;" vertex="1" parent="1">
                    <mxGeometry x="594" y="904" width="500" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="dfn" value="All four are built and runnable. The sweep that trains and compares them is not written yet. A high Dice on full is insufficient if the union baseline matches it on relational counterfactuals." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="594" y="956" width="500" height="120" as="geometry"/>
                </mxCell>

                <mxCell id="dg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="1130" y="716" width="530" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="dgt" value="&lt;b&gt;(g)&lt;/b&gt;  Counterfactuals  (must change the prediction)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="724" width="500" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="dgn" value="Architecture is sensitive to each of the first five by construction (test_stage_b_contract.py). Sensitivity is not correctness — the scored battery on a trained model is still to be written.&lt;br/&gt;&lt;br/&gt;1. permute anchor channels, prompt fixed&lt;br/&gt;2. permute prompt clauses, channels fixed&lt;br/&gt;3. replace one direction with its opposite&lt;br/&gt;4. replace one anchor shape name&lt;br/&gt;5. remove one anchor (empty channel)&lt;br/&gt;6. reorder channels and prompt together (expected no-op)&lt;br/&gt;&lt;br/&gt;Every run writes history.json, final_&amp;lt;split&amp;gt;_&amp;lt;source&amp;gt;.json, best.json / last.json with the provenance block (config, seeds, generator / direction / vocabulary / schema versions, git, hardware)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="1144" y="756" width="500" height="320" as="geometry"/>
                </mxCell>

                <mxCell id="capb" value="&lt;b&gt;Figure 2 (tab 2).&lt;/b&gt; Stage B is trained on oracle anchors (Phase 3) and only then evaluated with Stage A’s predicted anchors (Phase 4). The selection metric is compositional transfer onto two held-out target classes. See configs/train.yaml (stage_b_*), src/training/losses.py, src/evaluation/metrics.py, docs/dataset_schema.md, docs/stage_b_architecture.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1120" width="2120" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="capb2" value="Source: src/models/relational_vlm.py · src/models/anchor_provider.py · src/training/trainer.py (StageBOverfitRunner, StageBTrainer) · scripts/train_relational_model.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1174" width="2120" height="24" as="geometry"/>
                </mxCell>
            </root>
