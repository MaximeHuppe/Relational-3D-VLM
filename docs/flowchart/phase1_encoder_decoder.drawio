                <mxCell id="11" value="&lt;b&gt;aligned_queries&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;[B, N_T, 256]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.4;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="824" width="120" height="40" as="geometry"/>
