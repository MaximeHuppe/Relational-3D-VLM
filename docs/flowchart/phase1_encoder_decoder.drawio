    </diagram>
    <diagram name="Figure-1-Training-Data-Eval" id="stage-a-train-fig">
        <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1320" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="t0" value="&lt;font style='font-size:22px'&gt;&lt;b&gt;Stage A — Training, dataset, loss, metrics&lt;/b&gt;&lt;/font&gt;  &amp;nbsp; Phase 1  ·  scripts/train_shape_segmenter.py" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="16" width="1700" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="t1" value="One sample is a whole scene. Stage A must learn all ten shapes in every split because any name may later be requested as an anchor. The 7/2/1 target-class filter does not apply here." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#111111;" vertex="1" parent="1">
                    <mxGeometry x="40" y="48" width="1700" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="t2" value="Phase 0  data verification" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=1.4;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="40" y="84" width="220" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="t3" value="Phase 1  Stage A pretraining  ★ this figure" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="320" y="84" width="320" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="t4" value="Phases 2–3  Stage B (oracle)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="700" y="84" width="260" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="t5" value="Phase 4  predicted anchors from this checkpoint" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="1020" y="84" width="360" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="t6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="t2" target="t3">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="t3" target="t4">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="t4" target="t5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t9" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="30" y="150" width="460" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="t10" value="&lt;b&gt;(a)&lt;/b&gt;  Dataset  (Stage A view)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="44" y="158" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t11" value="&lt;b&gt;Corpus&lt;/b&gt;  500 synthetic scenes, RAS, spacing (1,1,1), grid 64³.&lt;br/&gt;Exactly one of each of 10 axis-aligned primitives; binary intensity; no overlap.&lt;br/&gt;Shapes: cube, cuboid, sphere, ellipsoid, cylinder, cone, pyramid, triangular_prism, torus, capsule.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Split (scenes, disjoint seeds)&lt;/b&gt;&lt;br/&gt;train 400 (seeds 1_000_000..) &amp;nbsp; val 50 (2_000_000..) &amp;nbsp; test 50 (3_000_000..)&lt;br/&gt;Stage A uses &lt;b&gt;all 10 classes&lt;/b&gt; in every split — no target-class filter.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;One training item&lt;/b&gt;&lt;br/&gt;scene_volume [1, 64, 64, 64] float &amp;nbsp;+&amp;nbsp; prompt_ids [10] (canonical name order)&lt;br/&gt;targets: 10 binary masks from instance_labels, same order.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Storage&lt;/b&gt;  data/processed/scenes/&amp;lt;id&amp;gt;.npz (uint8 volumes) + manifests/*.jsonl.&lt;br/&gt;Masks are materialised on load; fail-fast validation, never silent repair.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Augmentations&lt;/b&gt;  disabled in this milestone (relation rewrite not yet gated)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#222222;spacing=4;" vertex="1" parent="1">
                    <mxGeometry x="44" y="188" width="430" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="t12" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="510" y="150" width="480" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="t13" value="&lt;b&gt;(b)&lt;/b&gt;  Training loop" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="524" y="158" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t14" value="scene + prompt_ids" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1.3;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="560" y="196" width="380" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="t15" value="ShapeSegmenter  →  pred[0,1,2]  (16³, 32³, 64³)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=1.4;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="560" y="250" width="380" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="t16" value="deep_supervision_loss  (max-pool targets to each scale)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="560" y="308" width="380" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="t17" value="AdamW  →  cosine schedule  →  checkpoint on val_mean_dice" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="560" y="366" width="380" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="t18" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="t14" target="t15">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t19" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="t15" target="t16">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t20" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#333333;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="t16" target="t17">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="t21" value="&lt;b&gt;Default&lt;/b&gt;  60 epochs &amp;nbsp; AdamW lr=1e−3, wd=1e−5 &amp;nbsp; cosine, warmup 2&lt;br/&gt;seed 20260915 &amp;nbsp; threshold 0.5 &amp;nbsp; selection = val_mean_dice (max)&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Hardware&lt;/b&gt;  laptop_mps: B=4, accum=4 (eff. 16), bf16, workers=2&lt;br/&gt;rtx5090: B=8, accum=1, bf16, workers=8. Autocast off on CPU.&lt;br/&gt;Losses always in float32. bf16 not fp16 (fp16 zeroes 3.2% of grads).&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Profiles&lt;/b&gt;  default 8.02 M (C=32..256, E=256) &amp;nbsp; smoke 0.50 M (C=8..64, E=64)&lt;br/&gt;Smoke: 40 epochs, B=2, lr=2e−3, 16 train / 4 val scenes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="524" y="420" width="450" height="230" as="geometry"/>
                </mxCell>
                <mxCell id="t22" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="1010" y="150" width="460" height="520" as="geometry"/>
                </mxCell>
                <mxCell id="t23" value="&lt;b&gt;(c)&lt;/b&gt;  Loss  (documented CE+Dice equivalent)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1024" y="158" width="430" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t24" value="L = Σ_s w_s [ λ_dice · DiceLoss(pred_s, y_s) + λ_bce · BCEWithLogits(pred_s, y_s) ]&lt;br/&gt;s ∈ {16³, 32³, 64³} &amp;nbsp; w = (0.1, 0.3, 0.6) &amp;nbsp; λ_dice = λ_bce = 1" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontSize=11;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="1024" y="196" width="430" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="t25" value="Per-prompt &lt;b&gt;sigmoid&lt;/b&gt; Dice + BCE, not softmax CE: the head emits one independent logit volume per requested name, which is what lets Phase 4 query only the three named anchors. Shapes never overlap, so both formulations supervise the same partition.&lt;br/&gt;&lt;br/&gt;Soft Dice on sigmoid probabilities, smooth=1, averaged over batch and channel. BCE averaged over every element.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Target downsampling = max-pool&lt;/b&gt;, not nearest/average: at 16³ a torus is ~1 voxel thick and the alternatives can delete it, which would supervise the coarse head toward an empty mask.&lt;br/&gt;&lt;br/&gt;Inference uses pred[2] only. Deep-supervision maps are training-only." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="1024" y="280" width="430" height="370" as="geometry"/>
                </mxCell>
                <mxCell id="t26" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="30" y="690" width="710" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="t27" value="&lt;b&gt;(d)&lt;/b&gt;  Metrics and Phase-4 gate" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="44" y="698" width="400" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t28" value="Reported on the thresholded full-resolution map (τ = 0.5), per class plus macro average.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Dice&lt;/b&gt;  2|P∩T| / (|P|+|T|) &amp;nbsp;&amp;nbsp; &lt;b&gt;IoU&lt;/b&gt;  |P∩T| / |P∪T|&lt;br/&gt;Degenerate cases: both empty → 1.0; exactly one empty → 0.0.&lt;br/&gt;Hausdorff is a Stage B metric; it is not part of the Stage A report.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Checkpoint metric&lt;/b&gt;  val_mean_dice (macro over 10 classes). Provenance block (config, seeds, generator / direction / vocabulary / schema versions, git, hardware) is written next to the weights.&lt;br/&gt;&lt;br/&gt;&lt;b&gt;Phase-4 gate&lt;/b&gt;  all ten classes must reach a documented per-class Dice floor before predicted anchors are used. Smoke result (0.50 M, 16/4 scenes, 40 ep) is only evidence that the loop learns — judge Phase 1 on the full-corpus default profile." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="44" y="728" width="680" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="t29" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;" vertex="1" parent="1">
                    <mxGeometry x="760" y="690" width="710" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="t30" value="&lt;b&gt;(e)&lt;/b&gt;  Why this head, and how Phase 4 queries it" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=14;fontColor=#111111;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="774" y="698" width="680" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="t31" value="Queries never interact; visual features are never modulated. Two contracts the tests pin down:&lt;br/&gt;1. logits of a shape do not depend on which other shapes were requested;&lt;br/&gt;2. permuting prompt_ids permutes output channels and nothing else.&lt;br/&gt;&lt;br/&gt;That is exactly what anchor extraction by name needs:&lt;br/&gt;&lt;font face='monospace'&gt;predict_anchor_masks(scene, [name_1, name_2, name_3]) → [B, 3, 64³]&lt;/font&gt;&lt;br/&gt;The three names are the prompt's anchors, in clause order. The scene volume goes into Stage A and stops there; Stage B still receives only those three mask channels.&lt;br/&gt;&lt;br/&gt;Foreground prior p = 0.0016 (measured occupancy of one shape). Zero-init bias starts at p=0.5 and, measured, costs ~10× in early Dice (0.18 vs 0.66 at step 150)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="774" y="728" width="680" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="t32" value="&lt;b&gt;Figure 1 (tab 2).&lt;/b&gt; Stage A is trained independently of Stage B. The promptable per-name head is the documented equivalent of multiclass CE+Dice, chosen so Phase 4 can request any three names without retraining. See configs/train.yaml (stage_a), src/training/losses.py, src/evaluation/metrics.py, docs/dataset_schema.md." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;fontColor=#222222;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1090" width="1900" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="t33" value="Source: src/models/shape_segmenter.py · src/training/trainer.py (StageATrainer) · configs/model.yaml stage_a · configs/split.yaml · configs/train.yaml" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#555555;" vertex="1" parent="1">
                    <mxGeometry x="40" y="1144" width="1900" height="24" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>