                <mxCell id="8" value="&lt;b&gt;Visual_Features&lt;br&gt;&lt;/b&gt;&lt;font style=&quot;font-size:8px&quot;&gt;[B,256,8, 8, 8]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.4;fontSize=8;" parent="1" vertex="1">
