                </mxCell>
                <mxCell id="c161" value="bias_head&lt;br/&gt;&lt;font style='font-size:8px'&gt;W[1,C_vis]=0  b=logit(p)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=1.4;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="971" width="80" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c162" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" source="c149" target="c161" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1888" y="940"/>
                            <mxPoint x="1532" y="940"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c163" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=block;endFill=1;" parent="1" source="c161" target="c153" edge="1">
