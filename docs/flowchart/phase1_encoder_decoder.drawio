                <mxCell id="c142" value="PE: pos_d ∈ R^[1,8,1,1,256], pos_h ∈ R^[1,1,8,1,256], pos_w ∈ R^[1,1,1,8,256]. Runtime grid must match 8³ (512 tokens); a mismatch raises rather than interpolating." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1005" y="1116" width="440" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c143" value="" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1.2;fontSize=11;" parent="1" vertex="1">
                    <mxGeometry x="1478" y="760" width="472" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="c144" value="&lt;b&gt;(e)&lt;/b&gt;  StageVLFusionBlock  (mask head)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#111111;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="766" width="440" height="22" as="geometry"/>
                </mxCell>
                <mxCell id="c145" value="Per-prompt scaled dot-product plus per-query logit bias. Visual features stay unmodulated." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="792" width="440" height="18" as="geometry"/>
                </mxCell>
                <mxCell id="c146" value="Linear&lt;br/&gt;&lt;font style='font-size:8px'&gt;W[C_vis,256] b[C_vis]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="891" width="130" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c147" value="ReLU" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontSize=10;fontStyle=1;" parent="1" vertex="1">
                    <mxGeometry x="1640" y="891" width="56" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c148" value="Linear&lt;br/&gt;&lt;font style='font-size:8px'&gt;W[C_vis,C_vis] b[C_vis]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=1.4;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1714" y="891" width="110" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c149" value="F.layer_norm(C_vis)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.4;fontSize=8;" parent="1" vertex="1">
                    <mxGeometry x="1840" y="891" width="96" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="c150" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;endFill=1;endArrow=block;endFill=1;" parent="1" source="c146" target="c147" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c151" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;endFill=1;endArrow=block;endFill=1;" parent="1" source="c147" target="c148" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c152" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;strokeWidth=1.5;endArrow=block;endFill=1;endArrow=block;endFill=1;" parent="1" source="c148" target="c149" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c153" value="logits = (q̃ @ F_vis) / √C_vis + b(q̃)" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fixedSize=1;fontSize=10;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
                    <mxGeometry x="1629" y="971" width="280" height="48" as="geometry"/>
                </mxCell>
                <mxCell id="c154" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;strokeWidth=1.5;endArrow=block;endFill=1;endArrow=block;endFill=1;" parent="1" source="c149" target="c153" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c155" value="q̃ ∈ R^[B,N&lt;sub&gt;T&lt;/sub&gt;,C_vis] &amp;nbsp;·&amp;nbsp; F_vis ∈ R^[B,C_vis,DHW]  (flattened, unmodulated)&lt;br/&gt;b(q̃) = Linear(C_vis→1)(q̃) ∈ R^[B,N&lt;sub&gt;T&lt;/sub&gt;,1], weight zeros, bias = log(p/(1−p)), p=0.0016. C_vis ∈ {128, 64, 32}.&lt;br/&gt;Returns mask_logits [B,N&lt;sub&gt;T&lt;/sub&gt;,D,H,W] only (visual features stay unmodulated in-place)." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="1031" width="440" height="56" as="geometry"/>
                </mxCell>
                <mxCell id="c156" value="Scale 1/√C_vis avoids sigmoid saturation. Prior bias starts the head at p≈0.16% occupancy instead of p=0.5. Adding extra prompts does not change logits of a shared subset." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="1492" y="1086" width="440" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c157" value="&lt;b&gt;Figure 1.&lt;/b&gt; Stage A is a promptable 3D residual U-Net. A binary 64³ scene is encoded to a 256-channel bottleneck at 8³ (512 tokens). Learned closed-vocabulary embeddings (one token per shape name) are projected to 256-d queries and attend over the spatially position-encoded bottleneck (PromptDecoder). The same language-aligned queries are fused at three decoder scales via a scaled dot-product mask head with a per-query logit bias initialised to the foreground prior. Dashed orange: skip connections. Dashed blue: query reuse. Only pred[2] is used at inference; all three maps enter deep supervision (weights 0.1 / 0.3 / 0.6). Adapted from VoxDense: 64³ instead of 128³, learned name table instead of frozen PubMedBERT, prior bias instead of zeros." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#222222;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1176" width="1900" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c158" value="&lt;b&gt;Learned vs frozen.&lt;/b&gt; Everything is trained: Conv3d / Residual / PE / name Embedding / text Linear / MHA / decoder Conv / fusion MLP + per-query bias_head. IN has no affine γ,β. No frozen language model. Stage A is queried at Phase 4 with the three prompt-named anchors; it never feeds Stage B the scene volume." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontColor=#222222;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1246" width="1900" height="36" as="geometry"/>
                </mxCell>
                <mxCell id="c159" value="&lt;b&gt;Learned W (PyTorch layout)&lt;/b&gt; &amp;nbsp;&amp;nbsp; STEM Conv [32,1,3³] &amp;nbsp;·&amp;nbsp; trans. [64,32,3³] [128,64,3³] [256,128,3³] &amp;nbsp;·&amp;nbsp; Res×4: 2×[C,C,3³] &amp;nbsp;·&amp;nbsp; name Emb[10,256] + Linear W[256,256] &amp;nbsp;·&amp;nbsp; MHA in[768,256] out[256,256] &amp;nbsp;·&amp;nbsp; PE 3×8×256 &amp;nbsp;·&amp;nbsp; Up [128,384,3³] [64,192,3³] [32,96,3³] &amp;nbsp;·&amp;nbsp; Fusion MLP {128,64,32}←256 &amp;nbsp;·&amp;nbsp; bias_head [1,C_vis] (prior bias)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#bbbbbb;strokeWidth=1.2;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1290" width="1900" height="44" as="geometry"/>
                </mxCell>
                <mxCell id="c160" value="Notation: IN = InstanceNorm3d (affine=False). LN = LayerNorm (affine). PE&lt;sub&gt;3D&lt;/sub&gt; = decomposed learned positional encoding. N&lt;sub&gt;T&lt;/sub&gt; = prompt count (10 by default). DS = deep supervision. Training, loss, metrics and dataset: see the Training-Data-Eval tab." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontColor=#555555;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1342" width="1900" height="24" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="&lt;b&gt;ShapeNamePromptEncoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Emb(10,256)→Linear &amp;nbsp; [B, N_T, 256]&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1.4;fontSize=9;" parent="1" vertex="1">
                    <mxGeometry x="1010" y="814" width="120" height="40" as="geometry"/>
